# MCDEMO - MULTICOLOR BITMAP TEST IMAGE.
# DRAWS A FRAME, NESTED RECTANGLES, A FAN OF DIAGONALS FROM TWO CORNERS,
# A CENTER DOT GRID, A RULER WITH TICKS, AND TWO TEXT LABELS - ALL FROM
# THE MC DICT'S PLOT / DRAW / TEXT PRIMITIVES.
#
# USAGE (FROM THE TEXT REPL):
#     BITMAP(TRUE)              # ENTER GRAPHICS HEAP CONFIG (WARM RESTART)
#     LOAD("MCDEMO")()          # RUN THE DEMO
# AFTERWARD:  LOAD("TEXT").SHOW() TO RETURN TO THE TEXT DISPLAY.

M = LOAD("MC")
M.SHOW()
M.CLEAR()

# PALETTE:  BG ($D021) STAYS BLUE FROM M.SHOW(); 3 INK COLORS PICKED FOR
# CONTRAST AGAINST BLUE.
#   INK 1 (C01, MATRIX HI NIBBLE) -> YELLOW
#   INK 2 (C10, MATRIX LO NIBBLE) -> LIGHT RED
#   INK 3 (C11, COLOR RAM)        -> WHITE
M.COLOR(C01=7, C10=10, C11=1)

# OUTER FRAME (INK 3 = WHITE).
M.DRAW(X0=0,   Y0=0,   X1=159, Y1=0,   INK=3)
M.DRAW(X0=0,   Y0=199, X1=159, Y1=199, INK=3)
M.DRAW(X0=0,   Y0=0,   X1=0,   Y1=199, INK=3)
M.DRAW(X0=159, Y0=0,   X1=159, Y1=199, INK=3)

# INNER FRAME (INK 2 = LIGHT RED).
M.DRAW(X0=3,   Y0=3,   X1=156, Y1=3,   INK=2)
M.DRAW(X0=3,   Y0=196, X1=156, Y1=196, INK=2)
M.DRAW(X0=3,   Y0=3,   X1=3,   Y1=196, INK=2)
M.DRAW(X0=156, Y0=3,   X1=156, Y1=196, INK=2)

# X DIAGONALS THROUGH THE INTERIOR (INK 1 = YELLOW).
M.DRAW(X0=3,   Y0=3,   X1=156, Y1=196, INK=1)
M.DRAW(X0=156, Y0=3,   X1=3,   Y1=196, INK=1)

# FAN OF YELLOW RAYS FROM TOP-LEFT, EVERY 8 MC PIXELS ALONG THE BOTTOM.
FOR X IN RANGE(8, 156, 8):
  M.DRAW(X0=3, Y0=3, X1=X, Y1=196, INK=1)

# FAN OF LIGHT-RED RAYS FROM TOP-RIGHT.
FOR X IN RANGE(8, 156, 8):
  M.DRAW(X0=156, Y0=3, X1=X, Y1=196, INK=2)

# SIX WHITE DOTS IN A 2x3 GRID AROUND THE CENTER.
FOR Y IN RANGE(80, 130, 25):
  FOR X IN RANGE(50, 130, 30):
    M.PLOT(X=X, Y=Y, INK=3)

# A SHORT HORIZONTAL RULER AT Y=100 (RED) WITH WHITE TICKS EVERY 10 PIXELS.
M.DRAW(X0=10, Y0=100, X1=149, Y1=100, INK=2)
FOR X IN RANGE(10, 150, 10):
  M.DRAW(X0=X, Y0=97, X1=X, Y1=103, INK=3)

# TITLE TEXT TOP (WHITE) AND BOTTOM (YELLOW).
M.TEXT(COL=7,  ROW=1,  S="MULTICOLOR DEMO", INK=3, BG=0)
M.TEXT(COL=10, ROW=23, S="ADMIRAL64", INK=1, BG=0)

# WTEST - WINDOWING SMOKE TEST. PRINTS A RISING COUNTER INSIDE A
# WINDOW; THE WINDOW SCROLLS WITHIN ITS OWN BORDER.
#   LOAD("WTEST")()          RUN IT (RUN/STOP TO BREAK), OR
#   SPAWN(LOAD("WTEST"))     RUN IT AS A BACKGROUND TASK.
W = WINDOW(10, 5, 20, 6, "TEST")
T = 0
WHILE TRUE:
  PRINT T
  T += 1

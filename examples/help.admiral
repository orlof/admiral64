ADMIRAL - PYTHON-LIKE C64 LANG

BASICS
  X = 1 + 2
  S = "HI"
  L = [1, 2, 3]   L.APPEND(4)
  D = <"A": 1>    D.KEYS()
  IF / ELIF / ELSE   WHILE
  FOR I IN RANGE(N):
  # COMMENTS TO END OF LINE

STRINGS ARE LAMBDAS
  F = "PRINT 42"
  F()                 -> 42

DISK
  DIR()               LIST FILES
  SAVE("X", OBJ)      STORE OBJ
  L = LOAD("X")       READ BACK
  RM("X")             DELETE

EDIT(S) -> STR    [F-KEYS]
  F1 SAVE+EXIT    F3 CANCEL
  F5 CUT LINE     F7 PASTE

BUILTINS
  PRINT INPUT LEN RANGE TYPE
  ABS INT FLOAT STR REPR HEX
  SIN COS TAN EXP LOG SQRT
  RND CMP SORT
  MEM GLOBALS PEEK POKE

RUN PROGRAM FROM DISK
  F = LOAD("NEURON")
  F()

VIEW THIS HELP
  EDIT(LOAD("HELP"))     F3 EXITS
  F=LOAD("LESS")
  F(T=LOAD("HELP"))      PAGED OUTPUT

PRESS F3 TO EXIT THIS HELP

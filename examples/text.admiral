# TEXT - restore the 40x25 text display in the graphics memory
# config. Usage:  T = LOAD("TEXT")(); T.SHOW()

T = <>
T["_SHOW"] = CODE("\xE6\x01\xAD\x02\xDD\x09\x03\x8D\x02\xDD\xAD\x00\xDD\x09\x03\x8D\x00\xDD\xA9\x15\x8D\x18\xD0\xA9\x1B\x8D\x11\xD0\xA9\xC8\x8D\x16\xD0\xC6\x01\x60")
T["SHOW"] = "ME._SHOW()\nNONE"
RETURN T

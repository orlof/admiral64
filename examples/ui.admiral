# UI - WINDOWS AND MENUS ON TOP OF THE KERNEL WM BUILTINS.
#   F = LOAD("UI")
#   UI = F()
#   P = UI.OPEN(T="LOG", X=2, Y=2, W=20, H=8)   BORDERED WINDOW, UI METHODS
#   P.PRINT(S="HI")                             PRINT WITHOUT SWITCHING TARGET
#   C = UI.POPUP(T="FILE", I=["LOAD","SAVE","QUIT"], X=2, Y=2, W=12)
#   UI.ALERT(T="OOPS", M="DISK ERROR")
#   N = UI.ASK(T="LOAD", M="NAME?")
# MENU KEYS: CRSR UP/DOWN MOVE, RETURN SELECTS, F3 CANCELS (-1).
# WINDOWS OPENED WITH UI.OPEN GET THIS DICT AS THEIR PROTOTYPE, SO EVERY
# METHOD HERE IS ALSO A WINDOW METHOD. ADD YOUR OWN: UI.FOO = "..."

U = <>

U["OPEN"] = "P = WINDOW(X, Y, W, H, T)\nP._ = ME\nRETURN P"
U["CLOSE"] = "CLOSE(ME)\nRETURN NONE"
U["USE"] = "USE(ME)\nRETURN NONE"

U["WRITE"] = "Q = USE(ME)\nPRINT S\nUSE(Q)\nRETURN NONE"
U["STATUS"] = "Q = USE(ME)\nAT(ME, 0, 0)\nPRINT S\nUSE(Q)\nRETURN NONE"

U["MENU"] = "K = 0\nWHILE K < LEN(I):\n  AT(ME, 0, K)\n  PRINT I[K]\n  K = K + 1\nS = 0\nW = ME.W - 2\nATTR(ME, 0, 0, W, 1)\nWHILE 1:\n  C = ORD(GETC())\n  ATTR(ME, 0, S, W, 2)\n  IF C == 17:\n    S = (S + 1) % LEN(I)\n  ELIF C == 145:\n    S = (S + LEN(I) - 1) % LEN(I)\n  ELIF C == 13:\n    RETURN S\n  ELIF C == 134:\n    RETURN 0 - 1\n  ATTR(ME, 0, S, W, 1)"

U["POPUP"] = "P = ME.OPEN(T=T, X=X, Y=Y, W=W, H=LEN(I) + 2)\nR = P.MENU(I=I)\nP.CLOSE()\nRETURN R"

U["ALERT"] = "P = ME.OPEN(T=T, X=5, Y=10, W=30, H=4)\nPRINT M\nGETC()\nP.CLOSE()\nRETURN NONE"

U["ASK"] = "P = ME.OPEN(T=T, X=5, Y=10, W=30, H=3)\nPRINT M\nS = INPUT(\"\")\nP.CLOSE()\nRETURN S"

RETURN U

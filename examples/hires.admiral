H["DRAW"] = "TX = X1 - X0\nIF TX < 0:\n  DX = 0 - TX\n  SX = 0 - 1\nELSE:\n  DX = TX\n  SX = 1\nTY = Y1 - Y0\nIF TY < 0:\n  DY = TY\n  SY = 0 - 1\nELSE:\n  DY = 0 - TY\n  SY = 1\nER = DX + DY\nWHILE TRUE:\n  ME.PLOT(X=X0, Y=Y0)\n  IF X0 == X1:\n    IF Y0 == Y1:\n      BREAK\n  E2 = ER + ER\n  IF E2 >= DY:\n    ER = ER + DY\n    X0 = X0 + SX\n  IF E2 <= DX:\n    ER = ER + DX\n    Y0 = Y0 + SY"

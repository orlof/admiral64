H["_PLOT"] = "\xA0\x00\xB1\x10\x85\x1E\xC8\xB1\x10\x85\x1F\xA0\x00\xB1\x12\x85\x1C\x29\x07\x85\x1D\xA5\x1C\x4A\x4A\x4A\x0A\xAA\xBD\x40\xFF\x85\x10\xBD\x41\xFF\x18\x65\x1F\x85\x11\xA5\x1E\x29\xF8\x05\x1D\xA8\xA5\x1E\x29\x07\xAA\xA9\x80\xCA\x30\x03\x4A\x10\xFA\x11\x10\x91\x10\x60"
